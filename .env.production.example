APP_NAME="Maison Parfum"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://namadomainkamu.com
APP_KEY=base64:gEH86BlWOOkmC2OAMQ79J3ZuQa+VQRqrrDaPLKqc/eQ=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ─── DATABASE ─────────────────────────────────────────────
# OPSI A: MySQL/MariaDB (disarankan untuk shared hosting cPanel)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=isi_nama_database_cpanel
DB_USERNAME=isi_user_database_cpanel
DB_PASSWORD=isi_password_database_cpanel

# OPSI B: SQLite (alternatif jika hosting tidak sediakan MySQL).
# Aktifkan blok ini dan nonaktifkan blok MySQL di atas:
# DB_CONNECTION=sqlite
# DB_DATABASE=/home/username/maisonparfum/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=mail.namadomainkamu.com
MAIL_PORT=465
MAIL_USERNAME=info@namadomainkamu.com
MAIL_PASSWORD=isi_password_email
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@namadomainkamu.com"
MAIL_FROM_NAME="${APP_NAME}"
